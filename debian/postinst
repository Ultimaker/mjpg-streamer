#!/bin/sh
set -e

case "$1" in
    configure)
        # Restart the streaming service if systemd is running and the unit is
        # enabled.  The "|| true" ensures a missing/inactive unit is not fatal.
        if command -v systemctl >/dev/null 2>&1 && \
           systemctl is-enabled mjpg-streamer@0.service >/dev/null 2>&1; then
            systemctl restart mjpg-streamer@0.service || true
        fi
        ;;
esac

exit 0
